# ─────────────────────────────────────────────────────────────────────────────
#  Local dev environment — used by `vercel dev` only, NOT deployed
#  Copy this to .env.local and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# From merchant.cashfree.com → Developers → API Keys (Test mode)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox

# From Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the ENTIRE JSON file content as a single line (minified) here
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Your Vercel deployment base URL (set automatically in production, needed only locally)
BASE_URL=http://localhost:3000
