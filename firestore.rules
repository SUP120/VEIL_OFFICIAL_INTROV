// ─────────────────────────────────────────────────────────────────────────────
//  COPY THIS INTO:
//  Firebase Console → Firestore Database → Rules tab → Publish
//
//  ⚠  This file uses Firebase Security Rules syntax — NOT JavaScript.
//     Keep it as .rules  (or paste directly into the Firebase console).
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function safetyModerator() {
      return request.auth != null && request.auth.token.get('safetyModerator', false) == true;
    }

    function safetyAllowed(uid) {
      let path = /databases/$(database)/documents/safetyRestrictions/$(uid);
      return !exists(path) || (get(path).data.permanent == false && get(path).data.until <= request.time);
    }

    function contactAllowed(first, second) {
      return first is string && second is string && first != second
        && !exists(/databases/$(database)/documents/userBlocks/$(first)/blocked/$(second))
        && !exists(/databases/$(database)/documents/userBlocks/$(second)/blocked/$(first));
    }

    function activeMatchParticipant(matchId) {
      let matchData = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return request.auth != null && (request.auth.uid == matchData.userA || request.auth.uid == matchData.userB)
        && contactAllowed(matchData.userA, matchData.userB) && safetyAllowed(request.auth.uid);
    }

    match /userBlocks/{owner}/blocked/{target} {
      allow get: if request.auth != null && request.auth.uid in [owner, target];
      allow list: if request.auth != null && request.auth.uid == owner;
      allow create, update: if request.auth != null && request.auth.uid == owner && owner != target
        && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == owner;
    }

    match /safetyReports/{id} {
      allow read: if safetyModerator();
      match /actions/{actionId} {
        allow read: if safetyModerator();
      }
    }

    match /safetyFeedback/{id} {
      allow read: if safetyModerator();
    }

    match /safetyRestrictions/{uid} {
      allow get: if safetyModerator() || (request.auth != null && request.auth.uid == uid);
    }

    // People exposes only the existing public alias and an optional claimed handle.
    function peopleSettingsPath(uid) {
      return /databases/$(database)/documents/peopleSettings/$(uid);
    }

    function peopleProfilePath(uid) {
      return /databases/$(database)/documents/peopleProfiles/$(uid);
    }

    function peopleUsernamePath(username) {
      return /databases/$(database)/documents/peopleUsernames/$(username);
    }

    function validPeopleUsername(username) {
      return username is string && username.matches('^[a-z][a-z0-9_]{2,19}$')
        && !(username in ['admin', 'administrator', 'support', 'moderator', 'veil',
                          'solynlabs', 'google', 'system', 'staff', 'official']);
    }

    function peopleEligible(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return user.get('profileComplete', false) == true
        && user.get('isReviewerAccount', false) != true
        && user.get('isBanned', false) != true
        && safetyAllowed(uid);
    }

    function validPeopleSettings(uid) {
      let data = request.resource.data;
      let oldUsername = resource == null ? '' : resource.data.username;
      return data.keys().hasOnly(['listed', 'username'])
        && data.listed is bool && data.username is string
        && (data.username == '' || (validPeopleUsername(data.username)
          && getAfter(peopleUsernamePath(data.username)).data.uid == uid))
        && (oldUsername == '' || oldUsername == data.username || !existsAfter(peopleUsernamePath(oldUsername)))
        && (data.listed
          ? getAfter(peopleProfilePath(uid)).data.username == data.username
          : !existsAfter(peopleProfilePath(uid)));
    }

    match /peopleSettings/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && peopleEligible(uid) && validPeopleSettings(uid);
    }

    match /peopleProfiles/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 32;
      allow create, update: if request.auth != null && request.auth.uid == uid && peopleEligible(uid)
        && request.resource.data.keys().hasOnly(['alias', 'searchAlias', 'username'])
        && request.resource.data.alias is string
        && request.resource.data.alias.size() > 0 && request.resource.data.alias.size() <= 40
        && request.resource.data.searchAlias == request.resource.data.alias.lower()
        && getAfter(peopleSettingsPath(uid)).data.listed == true
        && getAfter(peopleSettingsPath(uid)).data.username == request.resource.data.username;
      allow delete: if request.auth != null && request.auth.uid == uid
        && getAfter(peopleSettingsPath(uid)).data.listed == false;
    }

    match /peopleUsernames/{username} {
      allow create: if request.auth != null && validPeopleUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(peopleSettingsPath(request.auth.uid)).data.username == username;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && getAfter(peopleSettingsPath(request.auth.uid)).data.username != username;
    }

    // ── User profiles ──────────────────────────────────────────────────────
    match /users/{userId} {
      // Owner can read & write their own doc fully
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Any signed-in user can read another member's profile (alias, emoji, etc.)
      allow read: if request.auth != null;
      match /savedPosts/{postId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
                              && request.resource.data.keys().hasOnly(['savedAt'])
                              && request.resource.data.savedAt is int;
      }
      match /group_chat_state/{roomId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['notificationMode', 'lastReadAt', 'pinned'])
          && request.resource.data.get('notificationMode', 'all') in ['all', 'replies', 'muted']
          && request.resource.data.get('lastReadAt', request.time) is timestamp
          && request.resource.data.get('pinned', false) is bool;
      }
      match /ai_conversations/{conversationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        match /messages/{messageId} {
          allow read: if request.auth != null && request.auth.uid == userId;
        }
      }
      match /ai_memories/{memoryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted'])
          && request.resource.data.isDeleted == true;
      }
      // Any authenticated user can update certain fields on other users' docs
      allow update: if request.auth != null
                 && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['groupId', 'lobbyRoomId']);
      // Allow incrementing approachesReceived, matchCount on another user's doc
      allow update: if request.auth != null
                 && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['approachesReceived', 'matchCount', 'freeApproachesUsedThisMonth',
                              'freeApproachesResetMonth']);
      // Moderation: admin can update ban/strike fields on ANY user
      allow update: if request.auth != null
                 && request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['isBanned', 'banType', 'bannedUntil', 'strikes',
                             'reportCount', 'isFlagged', 'flaggedInGroups',
                             'adminWarning', 'blockedUsers']);
      // Presence: user can update only their own onlineAt / lastSeen / showLastSeen
      allow update: if request.auth != null
                 && request.auth.uid == userId
                 && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['onlineAt', 'lastSeen', 'showLastSeen']);
    }

    // ── Matchmaking queue ──────────────────────────────────────────────────
    match /matchmaking_queue/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // ANY authenticated user can DELETE a queue entry
      // (needed so the group-forming transaction can remove all 4 members at once)
      allow delete: if request.auth != null;
    }

    // ── Lobby rooms ────────────────────────────────────────────────────────
    match /lobby_rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                 && resource.data.createdBy == request.auth.uid;
    }

    // ── Groups ─────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read, write: if request.auth != null;

      // ── ALL nested subcollections under groups: allow read for any signed-in user ──
      // Firestore rules do not cascade — each subcollection needs explicit rules.
      match /{allSubcollections=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // ── Daily questions: members write their own only ──────────────────
      match /daily_questions/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                  && docId.matches(request.auth.uid + '_.*');

        // ── Answers ───────────────────────────────────────────────────────
        match /answers/{answerUid} {
          allow read: if request.auth != null;
          allow write: if request.auth != null
                    && request.auth.uid == answerUid;

          // ── Reactions on an answer ────────────────────────────────────
          match /reactions/{reactorUid} {
            allow read: if request.auth != null;
            allow write: if request.auth != null
                      && request.auth.uid == reactorUid;
          }
        }
      }

      // ── Group-level reactions ─────────────────────────────────────────
      match /reactions/{uid}/sources/{sourceUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // ── Echoes (resonating with answers) ─────────────────────────────
      match /echoes/{answererUid}/sources/{echoUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == echoUid;
      }

      // ── Members sub-doc ───────────────────────────────────────────────
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // ── True-or-Myth guesses ──────────────────────────────────────────
      match /tom_guesses/{guesserUid}/guesses/{targetUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == guesserUid;
      }

      // ── Would You Rather picks ────────────────────────────────────────
      match /wyr_picks/{questionId}/answers/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // ── Game invites (Tic-Tac-Toe) ────────────────────────────────────
      match /game_invites/{inviteId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                   && request.resource.data.fromUid == request.auth.uid;
        allow update: if request.auth != null
                   && resource.data.toUid == request.auth.uid;
      }

      // ── Day 3 slow chat messages ──────────────────────────────────────
      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
      }

      // ── Bond scores ───────────────────────────────────────────────────
      match /bond_inputs/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Party sessions ─────────────────────────────────────────────────────
    match /party_sessions/{sessionId} {
      allow read: if request.auth != null
               && (resource.data.user1 == request.auth.uid
                || resource.data.user2 == request.auth.uid);
      allow write: if request.auth != null;

      // Chat messages — both members can read & write
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;  // messages are immutable once sent
      }

      // Game state subcollections — both members read & write
      match /game_finish/{docId}   { allow read, write: if request.auth != null; }
      match /game_hot_take/{docId} { allow read, write: if request.auth != null; }
      match /game_wyr/{docId}      { allow read, write: if request.auth != null; }
    }

    // ── Reports (user-reports a member) ───────────────────────────────────
    // Doc ID format: "{groupId}__{reporterUid}__{targetUid}"
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow list: if safetyModerator();
      // Legacy clients check their own deterministic document for duplicates.
      allow get: if safetyModerator() || (request.auth != null && (resource == null
        ? reportId.matches('.*__' + request.auth.uid + '__.*')
        : resource.data.reporterUid == request.auth.uid));
      allow update, delete: if false;
    }

    // ── Reported Questions (user reports a question card) ─────────────────
    match /reported_questions/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow read:   if safetyModerator();
      allow update, delete: if false;
    }

    // ── Admin logs ──────────────────────────────────────────────────────
    // Written by admin via app; read back in dashboard for audit trail.
    match /admin_logs/{actionId} {
      allow read, create: if safetyModerator();
      allow update, delete: if false;
    }

    // ── Admin actions log ─────────────────────────────────────────────────
    // Written by Cloud Function or admin-only; normal users cannot write here.
    match /admin_actions/{actionId} {
      allow read:   if safetyModerator();
      allow write:  if false;  // written only by Cloud Functions / Firebase console
    }

    // ── Aesthetics feed photos ─────────────────────────────────────────────
    // Written by the owning user; readable by any signed-in user in the same group.
    match /aesthetic_posts/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                 && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                 && resource.data.uid == request.auth.uid;
    }

    // ── Circle Vibes (Song · Color · One Word Bio) ─────────────────────────
    // Doc ID = "{groupId}_{uid}" — one entry per user per group.
    // Any signed-in user can read all vibes (to show the circle feed).
    // Only the owning user can create or overwrite their own vibe entry.
    match /vibes/{vibeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                 && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                 && resource.data.uid == request.auth.uid;
    }

    // ── Dare to Share answers (Day 2) ──────────────────────────────────────────
    // Doc ID = "{groupId}_{uid}" — one anonymous answer per user per group.
    // Readable by any signed-in user (feed is anonymous). Only owner can write.
    match /dare_answers/{answerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                 && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                 && resource.data.uid == request.auth.uid;
    }

    // ── Secret Compliments (Day 2) ─────────────────────────────────────────────
    // Doc ID = "{groupId}_{fromUid}" — one compliment per sender per group.
    // Only the recipient (toUid) and the sender (fromUid) can read.
    // Only the sender can create / update.
    match /secret_compliments/{complimentId} {
      allow read: if request.auth != null
                && (resource.data.toUid == request.auth.uid
                 || resource.data.fromUid == request.auth.uid);
      allow create, update: if request.auth != null
                 && request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null
                 && resource.data.fromUid == request.auth.uid;
    }

    // ── SWIPE FEATURE ──────────────────────────────────────────────────────────

    // ── Swipe Profiles ─────────────────────────────────────────────────────────
    // Any signed-in user can READ profiles (needed for the swipe feed).
    // Only the owner can CREATE or UPDATE their own profile.
    // Profiles with isProfileComplete == false are still readable (edge case tolerance).
    match /swipeProfiles/{uid} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                         && request.auth.uid == uid;
      allow delete:        if request.auth != null
                         && request.auth.uid == uid;
    }

    // ── Swipe Likes / Passes ───────────────────────────────────────────────────
    // A user can only read and write their OWN like/pass decisions.
    // BUT: when checking for mutual matches, a user also needs to read the OTHER
    // user's like on themselves — allow read if the doc ID equals the requester's UID.
    match /swipeLikes/{ownerUid}/given/{targetUid} {
      // Owner reads all their own decisions
      allow read, delete: if request.auth != null
                      && request.auth.uid == ownerUid;
      allow create, update: if request.auth != null && request.auth.uid == ownerUid
                          && contactAllowed(ownerUid, targetUid) && safetyAllowed(ownerUid);
      // Target reads the decision made about them (for mutual-match detection)
      allow read: if request.auth != null
               && request.auth.uid == targetUid;
    }

    // Who liked me — written by sender, readable/deletable by recipient only
    match /swipeLikes/{ownerUid}/received/{senderUid} {
      // Owner can read and delete their received likes (pass = delete)
      allow read, delete: if request.auth != null
                       && request.auth.uid == ownerUid;
      // Sender writes their like notification
      allow create, update: if request.auth != null
                         && request.auth.uid == senderUid
                         && contactAllowed(ownerUid, senderUid) && safetyAllowed(senderUid);
    }

    // ── Matches ────────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow create: if request.auth != null
                   && request.auth.uid in [request.resource.data.userA, request.resource.data.userB]
                   && contactAllowed(request.resource.data.userA, request.resource.data.userB)
                   && safetyAllowed(request.auth.uid);
      allow read:   if request.auth != null;
      allow update: if request.auth != null
                 && (resource.data.userA == request.auth.uid
                  || resource.data.userB == request.auth.uid)
                 && request.resource.data.userA == resource.data.userA
                 && request.resource.data.userB == resource.data.userB;
      allow delete: if request.auth != null
                 && (resource.data.userA == request.auth.uid
                  || resource.data.userB == request.auth.uid);

      // Chat messages inside the Connection Room
      match /messages/{messageId} {
        allow read: if activeMatchParticipant(matchId);
        // All message types: text, gift_cookies_N, flower_burst, voice_note::url, drawing::url, sticker_pack_*
        allow create: if activeMatchParticipant(matchId)
                   && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;  // messages are immutable once sent
      }
    }

    // ── LOVE GESTURES & MONETIZATION ───────────────────────────────────────────
    //
    //  All Love Gesture Firestore ops are covered by existing rules:
    //
    //  1. Cookie Gift crediting:
    //     Receiver self-credits their OWN users/{uid} doc (cookieBalance, cookiesEarned).
    //     → Covered by: allow write: if request.auth.uid == userId  (own-doc rule above)
    //
    //  2. Cookie spending (spendCookies transaction):
    //     Sender decrements their OWN cookieBalance, increments cookiesSpent.
    //     → Covered by: allow write: if request.auth.uid == userId
    //
    //  3. Chat messages (gift_cookies_N, flower_burst, voice_note::url, drawing::url):
    //     → Covered by: matches/{matchId}/messages allow create (senderUid check above)
    //
    //  4. Sticker pack unlock (ownedStickerPacks on own doc):
    //     → Covered by: allow write: if request.auth.uid == userId
    //
    // ──────────────────────────────────────────────────────────────────────────

    // ── User match index (denormalized for reliable querying) ─────────────────
    // Read: owner only. Write: any participant (needed when the OTHER user creates the match,
    // e.g. when a recipient accepts a friend approach and writes BOTH index entries in one batch).
    match /userMatches/{ownerUid}/index/{matchId} {
      allow read: if request.auth != null
                  && request.auth.uid == ownerUid;
      allow write: if request.auth != null;
    }


    // ── Swipe Compliments ──────────────────────────────────────────────────────
    // Sender writes compliment to recipient's sub-collection.
    // Only the recipient (owner of the parent doc) can read their received compliments.
    match /compliments/{recipientUid}/received/{senderUid} {
      allow read: if request.auth != null
               && request.auth.uid == recipientUid;
      allow create: if request.auth != null
                 && request.auth.uid == senderUid
                 && contactAllowed(recipientUid, senderUid) && safetyAllowed(senderUid);
      allow update, delete: if false;
    }


    // ── Veil Feed Posts ────────────────────────────────────────────────────────
    function onlyOwnFeedMembership(before, after) {
      return before == after || (before is list && after is list
        && after.size() == after.toSet().size()
        && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]));
    }

    function feedReactionCount(reactions) {
      let uid = request.auth.uid;
      return (uid in reactions.get('❤️', []) ? 1 : 0)
        + (uid in reactions.get('🥀', []) ? 1 : 0)
        + (uid in reactions.get('🌙', []) ? 1 : 0)
        + (uid in reactions.get('😂', []) ? 1 : 0)
        + (uid in reactions.get('🤍', []) ? 1 : 0);
    }

    function feedReactionUpdate() {
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.get('reactions', {});
      return before is map && after is map
        && after.diff(before).affectedKeys().hasOnly(['❤️', '🥀', '🌙', '😂', '🤍'])
        && onlyOwnFeedMembership(before.get('❤️', []), after.get('❤️', []))
        && onlyOwnFeedMembership(before.get('🥀', []), after.get('🥀', []))
        && onlyOwnFeedMembership(before.get('🌙', []), after.get('🌙', []))
        && onlyOwnFeedMembership(before.get('😂', []), after.get('😂', []))
        && onlyOwnFeedMembership(before.get('🤍', []), after.get('🤍', []))
        && feedReactionCount(after) == (request.auth.uid in request.resource.data.get('likedBy', []) ? 1 : 0);
    }

    function feedPollOptionText(option) {
      return option is string && option.size() >= 1 && option.size() <= 72;
    }

    function validNewFeedPoll(data) {
      let options = data.get('pollOptions', []);
      return !data.keys().hasAny(['pollOptions', 'pollCounts'])
        || (options is list && options.size() >= 2 && options.size() <= 4
          && options.toSet().size() == options.size()
          && feedPollOptionText(options[0]) && feedPollOptionText(options[1])
          && (options.size() < 3 || feedPollOptionText(options[2]))
          && (options.size() < 4 || feedPollOptionText(options[3]))
          && data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 240
          && data.pollCounts == [0, 0, 0, 0]);
    }

    function feedPollTallyAdvance(before, after, option) {
      let counts = before.pollCounts;
      return option is int && option >= 0 && option < before.pollOptions.size()
        && after.diff(before).affectedKeys().hasOnly(['pollCounts'])
        && after.pollCounts is list && after.pollCounts == [
          counts[0] + (option == 0 ? 1 : 0),
          counts[1] + (option == 1 ? 1 : 0),
          counts[2] + (option == 2 ? 1 : 0),
          counts[3] + (option == 3 ? 1 : 0)
        ];
    }

    function validFeedPollUpdate(postId) {
      let voter = /databases/$(database)/documents/veilPosts/$(postId)/pollVotes/$(request.auth.uid);
      return resource.data.keys().hasAll(['pollOptions', 'pollCounts'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollCounts'])
        && !exists(voter) && existsAfter(voter)
        && feedPollTallyAdvance(resource.data, request.resource.data, getAfter(voter).data.option);
    }

    match /veilPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                 && safetyAllowed(request.auth.uid)
                 && request.resource.data.authorUid == request.auth.uid
                 && validNewFeedPoll(request.resource.data);
      allow update: if request.auth != null
                 && ((resource.data.authorUid == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pollOptions', 'pollCounts'])
                    && (!resource.data.keys().hasAny(['pollOptions'])
                      || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['caption'])))
                  || validFeedPollUpdate(postId)
                  || (onlyOwnFeedMembership(resource.data.get('likedBy', []), request.resource.data.get('likedBy', []))
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'commentsCount'])
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'reactions'])
                        && feedReactionUpdate()))));
      allow delete: if request.auth != null
                 && resource.data.authorUid == request.auth.uid;

      match /pollVotes/{voterUid} {
        allow get: if request.auth != null && request.auth.uid == voterUid;
        allow create: if request.auth != null && request.auth.uid == voterUid
                     && safetyAllowed(voterUid)
                     && request.resource.data.keys().hasOnly(['option'])
                     && feedPollTallyAdvance(
                       get(/databases/$(database)/documents/veilPosts/$(postId)).data,
                       getAfter(/databases/$(database)/documents/veilPosts/$(postId)).data,
                       request.resource.data.option);
      }

      // ── Comments subcollection ────────────────────────────────────────────
      match /comments/{commentId} {
        // Any signed-in user can read comments on any post
        allow read: if request.auth != null;
        // Author can create their own comment (authorUid must match)
        allow create: if request.auth != null
                   && safetyAllowed(request.auth.uid)
                   && request.resource.data.authorUid == request.auth.uid;
        // Any signed-in user can update likedBy (toggling a comment like)
        // OR increment replyCount (when someone posts a reply)
        // Only the comment author can update other fields
        allow update: if request.auth != null
                   && (resource.data.authorUid == request.auth.uid
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['likedBy', 'replyCount']));
        // Only the comment author can delete their own comment
        allow delete: if request.auth != null
                   && resource.data.authorUid == request.auth.uid;

        // ── Replies sub-subcollection ──────────────────────────────────────
        match /replies/{replyId} {
          allow read:   if request.auth != null;
          allow create: if request.auth != null
                     && safetyAllowed(request.auth.uid)
                     && request.resource.data.authorUid == request.auth.uid;
          allow update: if request.auth != null
                     && resource.data.authorUid == request.auth.uid;
          allow delete: if request.auth != null
                     && resource.data.authorUid == request.auth.uid;
        }
      }
    }
    // Doc ID format: "{fromUid}_{toUid}"
    match /friendApproaches/{approachId} {
      // Any signed-in user can read — needed for existence checks on non-existent docs
      // (resource.data is null for non-existent docs, so field-level rules would always deny)
      allow read: if request.auth != null;
      // Sender can create (fromUid must match the creator)
      allow create: if request.auth != null
                 && request.resource.data.fromUid == request.auth.uid
                 && contactAllowed(request.resource.data.fromUid, request.resource.data.toUid)
                 && safetyAllowed(request.auth.uid);
      // Recipient updates status only (accept / decline)
      allow update: if request.auth != null
                 && resource.data.toUid == request.auth.uid
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // BOTH sender AND recipient can delete:
      //   Sender    → withdraws their approach
      //   Recipient → accepts or dismisses (deletes doc instead of status update)
      allow delete: if request.auth != null
                 && (resource.data.fromUid == request.auth.uid
                  || resource.data.toUid   == request.auth.uid);
    }

    // ── Purchase tokens (cookie idempotency guard) ─────────────────────────────
    // Written after a successful consumeAsync to prevent double-crediting.
    // Token IDs are unguessable 200-char Google Play purchase tokens — safe to
    // allow any authenticated user to read (they cannot guess other users' tokens).
    // IMPORTANT: `resource.data` is null for non-existing docs, so we CANNOT use
    // resource.data.uid in the read rule or it will deny reads on new token checks.
    match /purchases/{tokenId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                 && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Room Lobby (duplicate rule removed — already covered above) ────────
    // (Keeping a clean single definition above under lobby_rooms)

    // ── Shared Listening Rooms ─────────────────────────────────────────────────
    // Public lobby: any signed-in user can browse and join rooms.
    // Host creates the room. Participant joins by writing their uid.
    match /listeningRooms/{roomId} {
      // Anyone can read — needed for the lobby list
      allow read: if request.auth != null;
      // Host creates
      allow create: if request.auth != null
                 && request.resource.data.hostUid == request.auth.uid;
      // Host or participant can update (playback sync, joining, leaving)
      allow update: if request.auth != null
                 && (resource.data.hostUid        == request.auth.uid
                  || resource.data.participantUid == request.auth.uid
                  || resource.data.participantUid == "");  // open slot — anyone can join
      // Only host can delete / end room
      allow delete: if request.auth != null
                 && resource.data.hostUid == request.auth.uid;
    }

    // ── Sent Compliments (sender's own outbox) ─────────────────────────────────
    match /compliments/{senderUid}/sent/{recipientUid} {
      allow read, write: if request.auth != null
                      && request.auth.uid == senderUid;
    }

    // ── Feed Notifications (per-user inbox) ────────────────────────────────────
    // Each user can only read/write their own notification items.
    // Other users write to your inbox via the ViewModel (server-side trust is OK
    // here since we only store non-sensitive preview text).
    match /feedNotifications/{uid}/items/{notifId} {
      allow read, write: if request.auth != null
                      && request.auth.uid == uid;
      // Allow any authenticated user to CREATE a notification for any uid
      // (so commenter can notify post author, etc.)
      allow create: if request.auth != null;
    }

    // ── Introvert Feed Posts ───────────────────────────────────────────────────
    // Any signed-in user can read non-hidden posts. Author can create/delete.
    // Any user can update likeCount, reportCount, or hidden flag (client-side toggle).
    match /introvertPosts/{postId} {
      allow read:   if request.auth != null
                 && resource.data.get("hidden", false) == false;
      allow create: if request.auth != null
                 && safetyAllowed(request.auth.uid)
                 && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                 && (resource.data.authorId == request.auth.uid
                  || request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['likeCount', 'reportCount', 'hidden']));
      allow delete: if request.auth != null
                 && resource.data.authorId == request.auth.uid;

      // Likes subcollection — each user owns their like doc
      match /likes/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Reports subcollection — reporter writes once, can read their own
      match /reports/{reporterUid} {
        allow read:   if request.auth != null && request.auth.uid == reporterUid;
        allow create: if request.auth != null && request.auth.uid == reporterUid;
        allow update, delete: if false;
      }
    }

    // ── Introvert Posts — comments + replies ───────────────────────────────────
    match /introvertPosts/{postId}/comments/{commentId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                 && safetyAllowed(request.auth.uid)
                 && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                         && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                   && safetyAllowed(request.auth.uid)
                   && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null
                           && resource.data.authorId == request.auth.uid;
      }
    }

    // ── Game Rooms (Guess The Country) ────────────────────────────────────────
    match /gameRooms/{roomId} {
      // Any signed-in user can read (browse lobby)
      allow read: if request.auth != null;
      // Any signed-in user can create a room (they become host)
      allow create: if request.auth != null
                 && request.resource.data.hostUid == request.auth.uid;
      // Any signed-in user can update (joining, game state updates, scoring)
      allow update: if request.auth != null;
      // Only host can delete the room
      allow delete: if request.auth != null
                 && resource.data.hostUid == request.auth.uid;

      // Pre/post-game chat (waiting room & results screen)
      match /chat/{messageId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      // Legacy messages subcollection
      match /messages/{messageId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // ── Game Invites (broadcast to all Veil users) ────────────────────────
    match /gameInvites/{inviteId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Music Rooms ──────────────────────────────────────────────────────────
    match /musicRooms/{roomId} {
      // Any signed-in user can browse the lobby
      allow read: if request.auth != null;
      // Host creates the room
      allow create: if request.auth != null
                 && request.resource.data.hostUid == request.auth.uid;
      // Any member (uid in members array) OR host can update
      // (handles joining, leaving, playback sync, track changes)
      allow update: if request.auth != null
                 && (resource.data.hostUid == request.auth.uid
                  || request.auth.uid in resource.data.members
                  || resource.data.members.size() < resource.data.maxMembers);
      // Only host can delete
      allow delete: if request.auth != null
                 && resource.data.hostUid == request.auth.uid;

      // Chat messages inside the music room
      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false; // immutable
      }
    }

    // ── Music Room Invites (triggers Cloud Function FCM broadcast) ─────────────
    match /musicRoomInvites/{roomId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false; // Cloud Function handles cleanup
    }

    // ── Draw & Guess Rooms ────────────────────────────────────────────────────
    //
    //  Collection: drawGuessRooms/{roomId}
    //  Sub-collections:
    //    strokes/{strokeId}  — real-time drawing data (drawer writes, guesser reads)
    //    chat/{messageId}    — guess + lobby chat (both players read & write)
    //
    //  Access model:
    //    - Public rooms   (inviteType == "public")  → any signed-in user can read
    //    - Private rooms  (inviteType == "private") → only hostUid and guestUid
    //    - Strokes        → only host or guest, and only during a "playing" round
    //    - Chat / guesses → host or guest only
    // ─────────────────────────────────────────────────────────────────────────

    match /drawGuessRooms/{roomId} {

      // ── Room doc reads ───────────────────────────────────────────────────
      // Public rooms visible to all (lobby browser).
      // Private rooms visible only to host and guest.
      allow read: if request.auth != null
               && (resource.data.inviteType == "public"
                || resource.data.hostUid    == request.auth.uid
                || resource.data.guestUid   == request.auth.uid);

      // ── Room creation ────────────────────────────────────────────────────
      // Creator becomes host; inviteStatus must be "pending" (private) or
      // "accepted" (public self-created).
      allow create: if request.auth != null
                 && request.resource.data.hostUid == request.auth.uid;

      // ── Room updates ─────────────────────────────────────────────────────
      // Only host or guest may update the room document.
      // (Covers joining, ready-up, game-phase transitions, score increments.)
      allow update: if request.auth != null
                 && (resource.data.hostUid  == request.auth.uid
                  || resource.data.guestUid == request.auth.uid
                  // Guest slot open — anyone can join a public room
                  || (resource.data.inviteType == "public"
                   && resource.data.guestUid   == ""));

      // ── Room deletion ────────────────────────────────────────────────────
      // Only the host may delete the room.
      allow delete: if request.auth != null
                 && resource.data.hostUid == request.auth.uid;

      // ── Strokes sub-collection ───────────────────────────────────────────
      // Real-time canvas data. Only room participants can read or write.
      // Drawer creates strokes; anyone can delete (undo / clear canvas).
      match /strokes/{strokeId} {
        allow read: if request.auth != null
                 && (get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.hostUid  == request.auth.uid
                  || get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.guestUid == request.auth.uid);

        allow create: if request.auth != null
                   && (get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.hostUid  == request.auth.uid
                    || get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.guestUid == request.auth.uid);

        allow delete: if request.auth != null
                   && (get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.hostUid  == request.auth.uid
                    || get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.guestUid == request.auth.uid);

        allow update: if false; // strokes are immutable; replaced by delete + re-create
      }

      // ── Chat sub-collection ──────────────────────────────────────────────
      // Lobby chat and guess messages. Both players read & write.
      // Writer's uid must match the uid field in the message.
      match /chat/{messageId} {
        allow read: if request.auth != null
                 && (get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.hostUid  == request.auth.uid
                  || get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.guestUid == request.auth.uid);

        allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid
                   && (get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.hostUid  == request.auth.uid
                    || get(/databases/$(database)/documents/drawGuessRooms/$(roomId)).data.guestUid == request.auth.uid);

        allow update, delete: if false; // chat messages are immutable
      }
    }

    // ── game_invite_draw_guess messages in existing match chat ────────────────
    // The invite bubble (text = "game_invite_draw_guess::{roomId}") is stored in
    // matches/{matchId}/messages — already covered by the /matches rule above.
    // No additional rule needed.

    // ── Voice Rooms (LiveKit) ─────────────────────────────────────────────────
    match /voiceRooms/{roomId} {
      // Any signed-in user can read live room list / individual room
      allow read: if request.auth != null;

      // Only the creator can create a room (and must set themselves as host)
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Host can update anything (close room, update topic, etc.)
      // Any participant can update participantUids + participantCount (join/leave)
      allow update: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['participantUids', 'participantCount'])
                        || request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['isLive', 'closedReason']));

      // Only host can delete (close) a room
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }


    // ── Veil Sparks (Questions / Hot Takes / Confessions feed) ────────────────
    //  Collection:  veilSparks/{sparkId}
    //  Sub-colls:   answers/{answerId}           — Reddit-style scored answers
    //               answers/{answerId}/votes/{uid} — per-user vote record
    //               resonators/{uid}             — users who resonated
    match /veilSparks/{sparkId} {
      allow read: if request.auth != null;

      // Creator stamps their own authorId
      allow create: if request.auth != null
                 && request.resource.data.authorId == request.auth.uid;

      // Any signed-in user can bump resonanceCount / answerCount (counter fields)
      allow update: if request.auth != null;

      // Only author can delete their own spark
      allow delete: if request.auth != null
                 && resource.data.authorId == request.auth.uid;

      // ── Answers ────────────────────────────────────────────────────────────
      match /answers/{answerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                   && request.resource.data.authorId == request.auth.uid;
        // Any signed-in user can update score (up/down vote counter)
        allow update: if request.auth != null;
        allow delete: if request.auth != null
                   && resource.data.authorId == request.auth.uid;

        // Per-user vote doc — each user owns their vote record
        match /votes/{userId} {
          allow read, write: if request.auth != null
                          && request.auth.uid == userId;
        }
      }

      // ── Resonators ─────────────────────────────────────────────────────────
      match /resonators/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                  && request.auth.uid == userId;
      }

      // ── Dissenters (Nope / Disagree) ────────────────────────────────────────
      match /dissenters/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                  && request.auth.uid == userId;
      }
    }

    // ── Veil Admin Reports (post & chat reports) ──────────────────────────────
    // Any authenticated user can create their own report.
    // Normal users cannot read, update, or delete reports.
    match /veilReports/{reportId} {
      allow create: if request.auth != null
                 && request.resource.data.reportedBy == request.auth.uid;
      allow read:   if safetyModerator();
      allow update, delete: if false;
    }

    // Open group discovery, scoped membership changes, and member chat actions.
    function groupRoomData(roomId) {
      return get(/databases/$(database)/documents/group_rooms/$(roomId)).data;
    }

    function groupMember(roomId) {
      return request.auth != null
        && request.auth.uid in groupRoomData(roomId).get('memberUids', []);
    }

    function validGroupMembership() {
      let next = request.resource.data;
      let members = next.get('memberUids', []);
      let pending = next.get('pendingUids', []);
      return members is list && pending is list
        && members.size() == members.toSet().size()
        && pending.size() == pending.toSet().size()
        && members.toSet().intersection(pending.toSet()).size() == 0
        && next.memberCount == members.size();
    }

    function changeGroupMembership() {
      let uid = request.auth.uid;
      let owner = resource.data.get('createdBy', '');
      let beforeMembers = resource.data.get('memberUids', []).toSet();
      let afterMembers = request.resource.data.get('memberUids', []).toSet();
      let beforePending = resource.data.get('pendingUids', []).toSet();
      let afterPending = request.resource.data.get('pendingUids', []).toSet();
      let added = afterMembers.difference(beforeMembers);
      let removed = beforeMembers.difference(afterMembers);
      let requested = afterPending.difference(beforePending);
      let cleared = beforePending.difference(afterPending);
      return validGroupMembership() && (
        (resource.data.get('joinMode', 'auto') == 'auto'
          && added == [uid].toSet() && removed.size() == 0
          && requested.size() == 0 && cleared.difference([uid].toSet()).size() == 0)
        || (resource.data.get('joinMode', 'auto') == 'approve' && !(uid in beforeMembers)
          && added.size() == 0 && removed.size() == 0
          && requested == [uid].toSet() && cleared.size() == 0)
        || (added.size() == 0 && requested.size() == 0
          && ((uid != owner && removed == [uid].toSet() && cleared.size() == 0)
            || (removed.size() == 0 && cleared == [uid].toSet())))
        || (uid == owner && requested.size() == 0 && !(uid in removed)
          && added.difference(cleared).size() == 0
          && (removed.size() + cleared.size()) <= 1)
      );
    }

    match /group_push_devices/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 1024
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /group_rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && safetyAllowed(request.auth.uid)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('isSystem', false) == false
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.get('pendingUids', []) == []
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.get('description', '').size() <= 200
        && request.resource.data.get('joinMode', 'auto') in ['auto', 'approve']
        && validGroupMembership();

      allow update: if request.auth != null && safetyAllowed(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberUids', 'memberCount', 'pendingUids'])
        && changeGroupMembership();

      allow update: if request.auth != null && safetyAllowed(request.auth.uid)
        && request.auth.uid in resource.data.get('memberUids', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsg', 'lastMsgAt', 'lastMsgUid'])
        && request.resource.data.lastMsg is string && request.resource.data.lastMsg.size() <= 60
        && (resource.data.get('joinMode', 'auto') != 'approve' || request.resource.data.lastMsg == 'New message')
        && request.resource.data.lastMsgAt is timestamp
        && (request.resource.data.get('lastMsgUid', '') == request.auth.uid
          || request.resource.data.get('lastMsgUid', '') == resource.data.get('lastMsgUid', ''));

      allow update: if request.auth != null && safetyAllowed(request.auth.uid)
        && resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'joinMode', 'announcement'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.get('description', '').size() <= 200
        && request.resource.data.get('joinMode', 'auto') in ['auto', 'approve']
        && request.resource.data.get('announcement', '') is string
        && request.resource.data.get('announcement', '').size() <= 280;

      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid
        && resource.data.get('isSystem', false) == false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (groupRoomData(roomId).get('joinMode', 'auto') == 'auto' || groupMember(roomId));

        allow create: if groupMember(roomId) && safetyAllowed(request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid', 'alias', 'text', 'sentAt', 'replyToId', 'replyToAlias', 'replyToText', 'pushViaRelay'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.alias is string && request.resource.data.alias.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt is timestamp
          && request.resource.data.get('pushViaRelay', false) is bool
          && request.resource.data.get('replyToId', '').matches('^[A-Za-z0-9_-]{0,128}$')
          && request.resource.data.get('replyToAlias', '').size() <= 80
          && request.resource.data.get('replyToText', '').size() <= 120;

        allow update: if groupMember(roomId) && safetyAllowed(request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.get('reactions', {}) is map
          && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {}))
            .affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('reactions', {}))
            || request.resource.data.reactions[request.auth.uid] in ['❤️', '😂', '🙌', '🤍', '✨', '👍']);
      }
    }

    // ── Introvert Feed Connections / Feed Friends index ───────────────────────
    // Used by group invite loading — any signed-in user can read their own index.
    match /userFriends/{uid}/index/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

  }
}
