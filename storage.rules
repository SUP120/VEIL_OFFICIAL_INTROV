rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile photos — each user can only write their own ──────────────────
    // Path: profile_photos/{uid}.jpg
    match /profile_photos/{uid}.jpg {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024  // max 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Post images — users write to their own subfolder ─────────────────────
    // Path: post_images/{uid}/{imageId}.jpg
    match /post_images/{uid}/{imageId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024 // max 10 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
