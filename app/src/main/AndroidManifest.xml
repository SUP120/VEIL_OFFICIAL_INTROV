<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for Firebase + Google Sign-In -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- For profile photo picking -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- FCM push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Advertising ID — required by Firebase Analytics + OneSignal on Android 13+ -->
    <!-- Without this, ad ID is zeroed out and analytics/targeting breaks -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Google Play Billing â€” required for in-app purchases and subscriptions -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Voice notes — microphone access for MediaRecorder -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".VeilApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Veil"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Veil">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Veil"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Cashfree payment return deep link â€” required for Drop Checkout WebView redirect -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="veilapp" android:host="payment" />
            </intent-filter>
            <!-- Cashfree credits return deep link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="veilapp" android:host="credits" />
            </intent-filter>
        </activity>

        <!-- FCM Messaging Service — receives push notifications even when app is killed.
             Android routes incoming FCM messages to this service via the MESSAGING_EVENT
             intent action. Without this registration, data-only FCM messages (which wake
             the app from a killed state) are silently dropped. -->
        <service
            android:name=".notifications.VeilMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ML Kit: download face detection model at install time -->
        <!-- Without this, the model downloads lazily on first use and may not be ready -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />

        <!-- UCrop â€” circular photo cropping activity -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UCrop" />

        <!-- FileProvider for passing URI to UCrop on Android 7+ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>