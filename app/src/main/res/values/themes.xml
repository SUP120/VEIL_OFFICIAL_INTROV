<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Veil" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Theme for UCropActivity.
        The key items here stop the toolbar / tick button from being pushed
        behind or above the status bar on phones with notches or unusual
        screen orientations:
          • windowDrawsSystemBarBackgrounds  → system draws the status bar bg
          • fitsSystemWindows                → layout respects insets automatically
          • windowTranslucentStatus = false  → solid status bar, not translucent
            (translucent status bar is what causes the toolbar to start at y=0
             and the tick button to float into the status bar area)
    -->
    <style name="Theme.UCrop" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

</resources>