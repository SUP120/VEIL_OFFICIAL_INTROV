# ── Android / Gradle ──────────────────────────────────────────────────────────
*.iml
.gradle/
/local.properties
.idea/
.kotlin/
.DS_Store
/build/
app/build/
/captures/
.externalNativeBuild/
.cxx/
*.class

# ── SECRETS — never commit any of these ───────────────────────────────────────
# Firebase config (contains project ID, API keys, app ID)
google-services.json
app/google-services.json

# Android SDK path + Cloudinary + LiveKit keys
local.properties

# Release signing credentials
keystore.properties
*.keystore
*.jks

# Firebase Functions & API environment variables
functions/.env
functions/.env.local
functions/.env.*.local
veil-api/.env
veil-api/.env.local
cloudflare-worker/.env
cloudflare-worker/.dev.vars
cloudflare-worker/wrangler.toml

# Any generic .env files anywhere in the project
**/.env
**/.env.*
!**/.env.example

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
functions/node_modules/
veil-api/node_modules/
functions/.firebase/
veil-api/.vercel/

# ── Development & Build Noise ─────────────────────────────────────────────────
# JVM & process crash logs
hs_err_pid*.log
replay_pid*.log
*.log

# Scratch logs & text dumps
err.txt
errors_only.txt
kotlin_errors.txt
build_signed*.txt
*.recovered.*
*_recovered.*

# Executables & Installers
*.exe
*.msi
*.apk
*.aab

# Python bytecode
__pycache__/
*.pyc
*.pyo

# ── OS Generated Files ────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
.AppleDouble
.LSOverride
._*

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
