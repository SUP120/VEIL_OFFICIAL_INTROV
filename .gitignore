# ── SECRETS — never commit any of these ───────────────────────────────────────

# Firebase config (contains project ID, API keys, app ID)
google-services.json
app/google-services.json

# Android SDK path + Cloudinary + LiveKit keys
local.properties

# Release signing credentials
keystore.properties
*.keystore
*.jks

# Firebase Functions environment variables
functions/.env
functions/.env.local
functions/.env.*.local

# Cloudflare Worker secrets
cloudflare-worker/.env
cloudflare-worker/.dev.vars
cloudflare-worker/wrangler.toml

# Any generic .env files anywhere in the project
**/.env
**/.env.local
**/.env.production

# ── Development noise ─────────────────────────────────────────────────────────

# JVM crash logs
hs_err_pid*.log

# Python bytecode
__pycache__/
*.pyc
*.pyo

# One-off fix/utility scripts (kept locally, not for repo)
fix_*.py
fix_*.ps1
fix_*.bat
deep_fix_*.py
find_kotlin_*.py
restore_*.py
resize_*.ps1
copy_*.py

# Scratch files and personal notes
err.txt
errors_only.txt
kotlin_errors.txt
build_signed2.txt
desktop.ini

# Large raw assets not needed in repo (keep processed versions)
bird.png
island_base.png
sky_day.png
sky_night.png
glow.jpg
glow.png

# Internal dev docs (too detailed to expose publicly)
